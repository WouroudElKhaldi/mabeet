{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route}.{ts,tsx}",
    "src/components/{ui,shell,theme}/**/*.{ts,tsx}",
    "tests/**/*.test.{ts,tsx}",
    "src/modules/*/tests/**/*.test.{ts,tsx}",
    "tests/e2e/*.{spec,setup}.ts",
    "tests/e2e/prepare-database.ts",
    "src/lib/api-client.ts",
    "src/hooks/*.ts",
    "scripts/*.ts",
    "prisma/seed.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.ts", "prisma/**/*.ts"],
  "ignoreDependencies": [
    "eslint-config-next",
    "eslint-config-prettier",
    "tailwindcss",
    "@modelcontextprotocol/sdk",
    "aws4fetch",
    "web-push",
    "@types/web-push"
  ]
}
