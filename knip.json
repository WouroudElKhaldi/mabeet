{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route}.{ts,tsx}",
    "src/components/{ui,shell,theme}/**/*.{ts,tsx}",
    "tests/**/*.test.ts",
    "src/modules/*/tests/**/*.test.ts",
    "scripts/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.ts", "prisma/**/*.ts"],
  "ignoreDependencies": [
    "eslint-config-next",
    "eslint-config-prettier",
    "tailwindcss",
    "@better-auth/oauth-provider",
    "@modelcontextprotocol/sdk",
    "aws4fetch",
    "ical-generator",
    "motion",
    "node-ical",
    "sharp",
    "web-push",
    "@types/web-push"
  ]
}
