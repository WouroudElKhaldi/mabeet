# Copy this file to .env and fill it in. Never commit .env. Live values go in DigitalOcean's app settings and in
# GitHub secrets, never in the repository.

# ---------- Database ----------
# With `docker compose up` you need none of this section: Docker runs its own Postgres and Redis and points the app
# at them, whatever this file says. Without Docker, `pnpm db:start` runs the project's own Postgres (stored in .pgdata,
# port 5433; any password works, it is set on first start).
DATABASE_URL="postgresql://postgres:choose-a-password@localhost:5433/tafaddal"
# Separate database for integration tests (wiped by the tests). Created by `pnpm db:start` on first run.
TEST_DATABASE_URL="postgresql://postgres:choose-a-password@localhost:5433/tafaddal_test"
# Password of every demo account the seed creates. Empty = "demo-password-123". Set a private one on the live site.
SEED_PASSWORD=""

# ---------- Redis ----------
# Rate-limit counters shared by every web instance (Docker sets it to its redis service).
# Without Docker, leave it empty to count in memory.
REDIS_URL=""

# ---------- Sign in (Better Auth) ----------
# A long random string: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET="generate-a-long-random-string"
# The site's own address. The live site uses its public https URL.
BETTER_AUTH_URL="http://localhost:3000"

# ---------- Scheduled jobs ----------
# Protects /api/cron/* (manual runs of calendar sync and booking expiry). Same value in GitHub secrets.
CRON_SECRET="generate-a-long-random-string"

# ---------- Queues and the worker (pg-boss) ----------
# "queue" puts AI work, emails and scheduled jobs on Postgres queues for the worker, as in production.
# "inline" (no worker: everything runs in the website) only when you start the website alone. Tests always run inline.
JOBS_MODE="queue"
# In "queue" mode, AI work expected to take longer than this many seconds goes to the worker. 0 queues it all.
JOBS_SYNC_LIMIT_SECONDS="5"

# ---------- AI (DeepSeek) ----------
DEEPSEEK_API_KEY=""
# Monthly AI spend cap in US dollars (empty = the $50 default). Prices per million tokens default to DeepSeek's list price.
AI_MONTHLY_BUDGET_USD="50"
# AI_INPUT_USD_PER_M="0.28"
# AI_OUTPUT_USD_PER_M="0.42"

# ---------- Email (https://resend.com) ----------
# Leave the key empty to log emails instead of sending them.
# onboarding@resend.dev only delivers to your own Resend account email; verify a domain to send to anyone.
RESEND_API_KEY=""
EMAIL_FROM="Mabeet <onboarding@resend.dev>"

# ---------- Card payments (Stripe test mode, dashboard.stripe.com/test/apikeys) ----------
# Create two monthly prices (Pro, Business) and paste their ids.
# Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe, then paste the whsec_ secret it prints.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# ---------- Whish Pay ----------
# "simulator" needs no keys: a stand-in Whish payment page runs inside the app and follows Whish's real API (1.4.4)
# (test phone 96170123456, code 111111). With keys from Whish, set "sandbox" (or "production") and fill the rest.
WHISH_MODE="simulator"
WHISH_CHANNEL=""
WHISH_SECRET=""
WHISH_WEBSITE_URL=""

# ---------- Push notifications (Web Push) ----------
# Generate a pair once (`pnpm exec web-push generate-vapid-keys`) and paste both. Empty = push turned off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Who push services contact about our notifications.
VAPID_SUBJECT="mailto:hello@tafaddal.app"

# ---------- Photos (Cloudflare R2, free tier) ----------
# Uploaded photos are shrunk to WebP on our server (sharp), then stored in a public R2 bucket and served from
# R2_PUBLIC_URL. The live site must have these set. Free tier: 10 GB stored, 1 million uploads and 10 million reads a
# month, and no fee for traffic. The r2.dev address is rate limited and meant for development: the live site uses a
# custom domain on Cloudflare (for example https://images.tafaddal.app). R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are an
# R2 API token with "Object Read & Write" on this bucket only.
# Leave them empty on your computer and in tests: uploads are then kept in Postgres (StoredImage.bytes).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET=""
R2_PUBLIC_URL=""
