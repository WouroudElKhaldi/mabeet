# Before the domain: the website on the server's IP address, over plain HTTP. It also answers Let's Encrypt's
# check, so deploy/request-certificate.sh can get the first certificate while this file is in use.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    # Docker's own DNS. Through a variable, nginx looks the website up again every 10 seconds, so a website
    # container that restarted (and got a new address) is found without restarting nginx.
    resolver 127.0.0.11 valid=10s;
    set $website http://web:3000;

    # Photos are at most 2.5 MB (photo-service.ts); nginx's own limit is 1 MB.
    client_max_body_size 10m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass $website;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # nginx is the only proxy: both carry the real visitor address (rate limits read it), never one a visitor sent.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
