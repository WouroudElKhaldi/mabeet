# Only on the first deploy, for the seconds before the domain has its certificate: nginx answers Let's Encrypt's
# check for ${DOMAIN} and its www, and nothing else. The website is never served without https, and never on the
# server's IP address. deploy/remote-deploy.sh switches to https.conf.template once the certificate exists.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    # The IP address and any other name: the connection is closed without an answer.
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 503;
    }
}
