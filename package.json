{
  "name": "mabeet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/dev.ts",
    "dev:web": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/server/jobs/worker.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:start": "tsx scripts/local-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admins:create": "tsx scripts/create-admins.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "docs:erd": "tsx scripts/erd.ts",
    "docs:openapi-yaml": "tsx scripts/openapi-yaml.ts",
    "docs": "pnpm docs:erd && pnpm docs:openapi-yaml && prettier --write docs --log-level warn"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.19.3",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "ical-generator": "^11.1.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "node-ical": "^0.27.3",
    "pg-boss": "^12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
